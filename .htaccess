<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect www to the bare domain (keeps path and query string)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Remove trailing slash here, so Laravel's rule never adds "/public" to the URL
    RewriteCond %{DOCUMENT_ROOT}/public/$1 !-d
    RewriteRule ^(.+?)/+$ https://%{HTTP_HOST}/$1 [L,R=301]

    # Send everything to the public folder
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
